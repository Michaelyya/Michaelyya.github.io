{% assign conferences = site.data.conferences | reverse %}
{% if conferences and conferences.size > 0 %}
  <div class="conf-strip" data-conf-strip>
    <div class="conf-track" data-conf-track>
      {% for c in conferences %}
        {% if c.url %}
          <a class="conf-card" href="{{ c.url }}" target="_blank" rel="noopener noreferrer">
        {% else %}
          <div class="conf-card">
        {% endif %}
        <div class="conf-card-img">
          <img
            src="{{ c.image | relative_url }}"
            alt="{{ c.name }} in {{ c.place }}"
            loading="lazy"
            style="object-position: {{ c.focus | default: '50% 50%' }}"
          >
        </div>
        <div class="conf-card-body">
          <span class="conf-card-name">{{ c.name }}</span>
          <span class="conf-card-meta">
            {{- c.flag }}
            {{ c.place }} &middot; {{ c.date -}}
          </span>
        </div>
        {% if c.url %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
  {% include scripts/conferences_autoscroll.liquid %}
{% endif %}
