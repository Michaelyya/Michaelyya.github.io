---
layout: default
---
<div class="post about-page">
  <!-- Hero: portrait on the left, greeting + bio on the right. -->
  <section class="hero">
    <!--
      The portrait is revealed as a progressive decode: the photo starts as a
      coarse grid of blocks and resolves, step by step, to full resolution.
      The <img> stays in the DOM for accessibility and SEO; the <canvas> on top
      of it plays the animation and then fades away.
    -->
    <div class="hero-image" data-reveal title="Progressive decode — hover to replay">
      <img
        src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
        alt="{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}"
        loading="eager"
        {% if page.profile.image_circular %}
          class="is-circular"
        {% endif %}
      >
      <canvas class="reveal-canvas" aria-hidden="true"></canvas>
      <span class="reveal-step" aria-hidden="true"></span>
    </div>

    <div class="hero-text">
      <h1 class="hero-title">{{ page.greeting | default: 'Hello World!' }}</h1>
      {% if page.subtitle %}
        <p class="hero-subtitle">{{ page.subtitle }}</p>
      {% endif %}

      <div class="hero-bio">{{ content }}</div>

      {%- if page.profile.more_info %}
        <div class="more-info">{{ page.profile.more_info }}</div>
      {%- endif %}
    </div>
  </section>
  {% include scripts/photo_reveal.liquid %}

  <article>
    <!-- Selected papers -->
    {% if page.selected_papers -%}
      <h2 class="section-title">
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      {%- include selected_papers.liquid %}
    {%- endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="section-title">News</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Conference highlights -->
    {% if page.conferences and site.data.conferences %}
      <h2 class="section-title">
        Conference Highlights
        <span class="section-hint">hover to pause</span>
      </h2>
      {% include conferences.liquid %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2 class="section-title">
        <a href="{{ '/blog/' | relative_url }}">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}
  </article>
</div>
